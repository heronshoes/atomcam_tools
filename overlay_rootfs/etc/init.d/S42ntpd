#!/bin/sh
#
# Start network time daemon
#

case "$1" in
  start)
    logger -s "Starting ntpd: "
    # udhcpc may still be getting an address here. Wait for the network so that recording,
    # which names its files by the time, starts with the correct time.
    for i in `seq 30` ; do
      ping -c 1 -W 1 ntp.nict.jp > /dev/null 2>&1 && break
      sleep 1
    done
    if ping -c 1 -W 1 ntp.nict.jp > /dev/null 2>&1 && timeout -t 20 /usr/sbin/ntpd -qn -p ntp.nict.jp ; then
      /usr/sbin/ntpd -p ntp.nict.jp
      [ $? == 0 ] && logger -s "OK" || logger -s "FAIL"
      exit 0
    fi
    # no network yet: use the saved time and keep waiting in the background so the boot continues;
    # started without the network, ntpd cannot resolve the server and exits
    [ -f /media/mmc/time.ini ] && date -s @`sed -ne 's/utc=//p' /media/mmc/time.ini`
    touch /tmp/ntpd_waiting
    (
      [ -f /etc/environment ] && . /etc/environment
      [ -f /media/mmc/TZ ] && TZ=`cat /media/mmc/TZ`
      export TZ
      for i in `seq 60` ; do
        ping -c 1 -W 1 ntp.nict.jp > /dev/null 2>&1 && break
        sleep 2
      done
      if timeout -t 30 /usr/sbin/ntpd -qn -p ntp.nict.jp ; then
        echo `date +"%Y/%m/%d %H:%M:%S"` ": ntpd synced late (uptime `cut -d' ' -f1 /proc/uptime`)" >> /media/mmc/atomhack.log
      else
        echo `date +"%Y/%m/%d %H:%M:%S"` ": ntpd sync failed (uptime `cut -d' ' -f1 /proc/uptime`)" >> /media/mmc/atomhack.log
      fi
      /usr/sbin/ntpd -p ntp.nict.jp
      [ $? == 0 ] && logger -s "OK" || logger -s "FAIL"
      rm -f /tmp/ntpd_waiting
    ) < /dev/null > /dev/null 2>&1 &
  ;;
  stop)
    logger -s "Stopping ntpd: "
    killall ntpd
    [ $? == 0 ] && logger -s "OK" || logger -s "FAIL"
  ;;
  watchdog)
    [ -f /tmp/ntpd_waiting ] && exit 0
    pidof ntpd > /dev/null && exit 0
    echo `date +"%Y/%m/%d %H:%M:%S"` ": ntpd restart"
    /usr/sbin/ntpd -p ntp.nict.jp
  ;;
  restart|reload)
    "$0" stop
    "$0" start
  ;;
  *)
    echo "Usage: $0 {start|stop|restart|watchdog}"
    exit 1
esac

exit $?
